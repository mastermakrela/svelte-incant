{
	"name": "svelte-incant",
	"version": "0.9.1",
	"license": "MIT",
	"repository": {
		"url": "https://github.com/mastermakrela/svelte-incant"
	},
	"bugs": "https://github.com/mastermakrela/svelte-incant/issues",
	"homepage": "https://svelte-incant.mastermakrela.com/",
	"author": "mastermakrela <github@mastermakrela.com>",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && npm run prepack",
		"preview": "vite preview",
		"prepare": "husky && svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"lint:fix": "prettier --write . && eslint --fix .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright test"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": false,
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		}
	},
	"peerDependencies": {
		"svelte": "^5.42.0",
		"bits-ui": "^2.0.0",
		"@tanstack/hotkeys": "0.9.0",
		"@tanstack/svelte-hotkeys": "^0.11.0"
	},
	"dependencies": {
		"@lucide/svelte": "^1.47.0"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@internationalized/date": "^3.12.4",
		"@playwright/test": "^1.63.0",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/svelte-hotkeys": "^0.11.0",
		"@types/node": "^26.6.2",
		"@vitest/browser-playwright": "^5.0.1",
		"bits-ui": "^2.19.2",
		"clsx": "^2.1.1",
		"copy-to-clipboard": "^4.0.2",
		"eslint": "^10.11.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.12.0",
		"highlight.js": "^11.12.0",
		"husky": "^9.1.7",
		"jsrepo": "^3.8.1",
		"playwright": "^1.63.0",
		"prettier": "^3.9.8",
		"prettier-plugin-organize-imports": "^4.3.0",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"publint": "^0.3.24",
		"runed": "^0.37.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.70.1",
		"vite": "^8.3.0",
		"vitest": "^5.0.1",
		"vitest-browser-svelte": "^3.1.0"
	},
	"keywords": [
		"svelte",
		"keyboard shortcuts",
		"shortcuts"
	]
}
